{
  "name": "solar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Solar — a real-scale, data-driven 3D solar system simulation for the web",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode standalone",
    "build:server": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:textures": "node scripts/fetch-textures.mjs && node scripts/optimize-textures.mjs",
    "optimize:textures": "node scripts/optimize-textures.mjs",
    "fetch:reference": "node scripts/fetch-reference.mjs",
    "fetch:satellites": "node scripts/fetch-satellites.mjs && node scripts/parse-satellites.mjs",
    "gen:moons": "node scripts/gen-moon-orbits.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
